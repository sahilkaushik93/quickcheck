# Per-request API fields override these provider defaults.
LLM_PROVIDER=ollama
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=700
OLLAMA_KEEP_ALIVE=5m
LLM_TIMEOUT_SECONDS=180

# Optional providers. Never commit real credentials.
LAUNCHPAD_API_URL=http://127.0.0.1:8080/generate/single
DOC_INTELLIGENCE_API_URL=
DOC_INTELLIGENCE_USERNAME=
DOC_INTELLIGENCE_PASSWORD=

# Upload safeguards (bytes/count).
UNDQ_MAX_CSV_UPLOAD_BYTES=5368709120
UNDQ_MAX_METADATA_UPLOAD_BYTES=52428800
UNDQ_MAX_RULES_ARCHIVE_BYTES=52428800
UNDQ_MAX_RULE_FILE_BYTES=2097152
UNDQ_MAX_RULE_COUNT=500
UNDQ_MAX_RULES_UNCOMPRESSED_BYTES=104857600

# Replace this example with a private deployment-specific value.
UNDQ_EVIDENCE_HASH_SALT=replace-with-a-long-random-deployment-secret
UNDQ_EXECUTION_OUTPUT_ROOT=data/execution_layer
UNDQ_API_BASE_URL=http://127.0.0.1:8000
UNDQ_UI_HTTP_TIMEOUT_SECONDS=300
UNDQ_CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
