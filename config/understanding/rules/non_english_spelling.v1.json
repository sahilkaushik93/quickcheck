{
  "schema_version": "1.0",
  "rule_id": "non_english_spelling",
  "version": "2.0.0",
  "check_name": "non_english_spelling",
  "title": "Non-English and unknown-token assessment",
  "description": "Separates multilingual content from potentially misspelled or unrecognized transcript tokens.",
  "dimension": "accuracy",
  "severity": "medium",
  "level": "column",
  "lifecycle": "approved",
  "enabled": true,
  "owner": "Language Analytics Owner",
  "execution_handler": "non_english_spelling",
  "execution_strategy": "streaming_row",
  "selector": {"column_name_patterns": ["^(trnscr_(clean_read_)?tx|transcript(_text)?)$"], "minimum_domain_confidence": 0.45, "match_mode": "any"},
  "required_capabilities": ["execution.transcript_stream", "execution.language_detector", "execution.spell_checker"],
  "parameters": {
    "expected_language": {"parameter_type": "string", "description": "Primary ISO language; Spanish and mixed speech remain allowed by ontology.", "required": true, "default": "en"},
    "maximum_unknown_token_rate": {"parameter_type": "number", "description": "Maximum acceptable unknown-token rate.", "required": true, "default": 0.05, "minimum": 0.0, "maximum": 1.0},
    "minimum_token_length": {"parameter_type": "integer", "description": "Shortest token included in spelling evaluation.", "required": true, "default": 3, "minimum": 1}
  },
  "evidence_policy": {"max_evidence_items": 10, "include_aggregate_metrics": true, "include_raw_values": false, "include_transcript_text": false, "redact_matches": true},
  "business_dimensions": ["transcription_accuracy", "language_coverage"],
  "tags": ["mvp", "language", "spelling"],
  "suggested_by_llm": false,
  "approved_by": "DQ Governance MVP"
}
