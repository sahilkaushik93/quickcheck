{
  "schema_version": "1.0",
  "rule_id": "agent_speaker_tag_validation",
  "version": "2.0.0",
  "check_name": "agent_speaker_tag_validation",
  "title": "Agent and customer speaker-tag validation",
  "description": "Validates speaker labels, ordering and agent/customer role consistency.",
  "dimension": "validity",
  "severity": "high",
  "level": "relationship",
  "lifecycle": "approved",
  "enabled": true,
  "owner": "Transcript Pipeline Owner",
  "execution_handler": "agent_speaker_tag_validation",
  "execution_strategy": "streaming_row",
  "selector": {"column_name_patterns": ["^(trnscr_(clean_read_)?tx|transcript(_text)?)$"], "minimum_domain_confidence": 0.45, "match_mode": "any"},
  "required_capabilities": ["execution.transcript_stream", "execution.speaker_tag_parser"],
  "parameters": {
    "allowed_speaker_labels": {"parameter_type": "string_list", "description": "Approved normalized speaker labels.", "required": true, "default": ["agent", "customer", "caller", "representative"]},
    "maximum_invalid_rate": {"parameter_type": "number", "description": "Maximum acceptable invalid-tag rate at confidence >= 0.80.", "required": true, "default": 0.01, "minimum": 0.0, "maximum": 1.0}
  },
  "evidence_policy": {"max_evidence_items": 10, "include_aggregate_metrics": true, "include_raw_values": false, "include_transcript_text": false, "redact_matches": true},
  "business_dimensions": ["agent_attribution", "conversation_integrity"],
  "tags": ["mvp", "speaker", "transcript"],
  "suggested_by_llm": false,
  "approved_by": "DQ Governance MVP"
}
