{
  "schema_version": "1.0",
  "rule_id": "speech_per_duration_rate",
  "version": "2.0.0",
  "check_name": "speech_per_duration_rate",
  "title": "Speech words per duration",
  "description": "Validates transcript word volume against aligned media duration.",
  "dimension": "consistency",
  "severity": "high",
  "level": "relationship",
  "lifecycle": "approved",
  "enabled": true,
  "owner": "Transcript Pipeline Owner",
  "execution_handler": "speech_per_duration_rate",
  "execution_strategy": "streaming_pair",
  "selector": {"column_name_patterns": ["^(trnscr_(clean_read_)?tx|transcript(_text)?|media_fl_dur_mscnd|duration_(milliseconds|seconds))$"], "minimum_domain_confidence": 0.45, "match_mode": "any"},
  "required_capabilities": ["execution.transcript_stream", "execution.duration_pairing", "execution.word_counter"],
  "parameters": {
    "duration_unit": {"parameter_type": "string", "description": "Unit used by the selected duration column.", "required": true, "default": "milliseconds", "allowed_values": ["milliseconds", "seconds"]},
    "minimum_words_per_minute": {"parameter_type": "number", "description": "Lower pass bound from validation table.", "required": true, "default": 40.0, "minimum": 0.0},
    "maximum_words_per_minute": {"parameter_type": "number", "description": "Upper pass bound from validation table.", "required": true, "default": 250.0, "minimum": 0.0},
    "warning_minimum_words_per_minute": {"parameter_type": "number", "description": "Lower warning bound.", "required": true, "default": 30.0, "minimum": 0.0},
    "warning_maximum_words_per_minute": {"parameter_type": "number", "description": "Upper warning bound.", "required": true, "default": 300.0, "minimum": 0.0},
    "minimum_duration": {"parameter_type": "number", "description": "Minimum valid duration in configured units.", "required": true, "default": 1000.0, "minimum": 0.0}
  },
  "evidence_policy": {"max_evidence_items": 10, "include_aggregate_metrics": true, "include_raw_values": false, "include_transcript_text": false, "redact_matches": true},
  "business_dimensions": ["transcript_completeness", "media_alignment"],
  "tags": ["mvp", "speech_rate", "duration"],
  "suggested_by_llm": false,
  "approved_by": "DQ Governance MVP"
}
