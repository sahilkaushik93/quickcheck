{
  "schema_version": "1.0",
  "policy_id": "undq-public-query-policy",
  "policy_version": "1.0.0",
  "query_requirements": {
    "minimum_length": 3,
    "maximum_length": 300,
    "allow_direct_urls": false,
    "allow_user_supplied_query_text": false,
    "allow_llm_supplied_query_text": false,
    "require_topic_mapping_template": true,
    "require_approved_source_ids": true,
    "sanitize_whitespace": true,
    "reject_on_forbidden_match": true
  },
  "forbidden_literals": ["undq", "lumi", "quickcheck", "nexidia", "dq engine", "data quality engine", "american express internal", "control weakness", "dataset", "csv", "column", "transcript", "sample file", "request_id"],
  "forbidden_patterns": [
    "(?i)\\b[a-z_][a-z0-9_]*_(?:id|nm|tx|dt|ts)\\b",
    "(?i)\\b(?:\\d{1,3}(?:\\.\\d+)?\\s*%|\\d{1,3}(?:\\.\\d+)?\\s*percent)\\b",
    "(?i)\\b(?:password|secret|token|api[_ -]?key|authorization|bearer)\\b",
    "(?i)\\b(?:email|phone|ssn|social security|credit card|debit card|account number|customer identifier)\\b",
    "(?i)\\b(?:https?://|www\\.)",
    "(?i)\\b(?:[a-f0-9]{32,}|sha256:)\\b"
  ],
  "allowed_character_pattern": "^[A-Za-z0-9 ,.&()/-]+$",
  "audit": {"log_query_hash_only": true, "log_raw_query": false, "include_rejection_reason": true}
}
